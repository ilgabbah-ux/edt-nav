# EDT Nav - moto enduro "Off facile"
# preferisce sterrate facili (grade1-3) alle strade asfaltate, evita sterrate dure,
# NON passa su sentieri/mulattiere pedonali e rispetta i divieti di transito ai mezzi a motore.

---context:global
assign processUnusedTags = false
assign validForBikes = false
assign validForFoot = false
assign validForCars = true
assign turnInstructionMode = 1
assign downhillcost = 0
assign downhillcutoff = 0
assign uphillcost = 0
assign uphillcutoff = 0

---context:way

assign motorallowed =
  or motor_vehicle=yes|permissive|designated
     motorcycle=yes|permissive|designated

assign motorforbidden =
  or motor_vehicle=no|private|agricultural|destination
  or motorcycle=no|private
  or access=no|private|agricultural
     vehicle=no|private

assign forbidden =
  if motorallowed then false
  else motorforbidden

assign hwcost =
  switch highway=motorway|motorway_link 10000
  switch highway=trunk|trunk_link 6
  switch highway=primary|primary_link 3
  switch highway=secondary|secondary_link 1.8
  switch highway=tertiary|tertiary_link 1.4
  switch highway=unclassified 1.15
  switch highway=residential|living_street 1.4
  switch highway=service 1.6
  switch highway=track
    switch tracktype=grade1 1.0
    switch tracktype=grade2 1.0
    switch tracktype=grade3 1.15
    switch tracktype=grade4 2.5
    switch tracktype=grade5 6
    1.3
  10000

assign smoothpenalty =
  switch smoothness=very_bad 2
  switch smoothness=horrible|very_horrible|impassable 6
  1

assign costfactor =
  if forbidden then 10000
  else multiply hwcost smoothpenalty

assign turncost = 0
assign initialcost = 0

---context:node
assign initialcost = 0
